{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon.svg",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "!/runtime-config.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "runtime-config",
      "urls": [
        "/runtime-config.js"
      ],
      "cacheConfig": {
        "maxSize": 1,
        "maxAge": "30d",
        "timeout": "2s",
        "strategy": "freshness"
      }
    },
    {
      "name": "public-readonly",
      "urls": [
        "**/api/v1/public/trips/**",
        "**/api/v1/airports/**"
      ],
      "cacheConfig": {
        "maxSize": 25,
        "maxAge": "7d",
        "timeout": "3s",
        "strategy": "freshness"
      }
    }
  ],
  "appData": {
    "version": "0.9.19-beta",
    "date": "2026-11-29",
    "title": {
      "zh-TW": "真實航線地圖、介面減噪與登入預覽",
      "en": "Real Flight Map & Visual Polish"
    },
    "changes": {
      "zh-TW": [
        "足跡頁升級為雙欄寬幅版面，依真實航班繪製單一世界地圖航線",
        "登入頁新增多國行程預覽卡，每次開啟皆隨機輪播不同目的地",
        "統一全站按鈕與標籤圓角並減少邊框雜訊，切換分頁版面更穩定"
      ],
      "en": [
        "Redesigned the Logbook hero with a real-flight single-Earth map beside distance stats",
        "Added randomized multi-country itinerary previews to the login screen across six destinations",
        "Unified control corners, reduced nested card borders, and aligned brief and expense spacing"
      ]
    }
  }
}
