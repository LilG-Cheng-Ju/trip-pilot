{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon.svg",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "!/runtime-config.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "runtime-config",
      "urls": [
        "/runtime-config.js"
      ],
      "cacheConfig": {
        "maxSize": 1,
        "maxAge": "30d",
        "timeout": "2s",
        "strategy": "freshness"
      }
    },
    {
      "name": "public-readonly",
      "urls": [
        "**/api/v1/public/trips/**",
        "**/api/v1/airports/**"
      ],
      "cacheConfig": {
        "maxSize": 25,
        "maxAge": "7d",
        "timeout": "3s",
        "strategy": "freshness"
      }
    }
  ],
  "appData": {
    "version": "0.9.18-beta",
    "date": "2026-11-28",
    "title": {
      "zh-TW": "介面視覺與字型載入優化",
      "en": "Visual Polish & Faster Font Loads"
    },
    "changes": {
      "zh-TW": [
        "更新登入頁航圖視覺與品牌文案，新手空狀態改為精簡引導",
        "足跡主視覺航線改依真實飛行與旅程資料呈現，並統一卡片標籤樣式",
        "精簡中文字型下載並縮小首屏檔案，行動漫遊開啟更省流量"
      ],
      "en": [
        "Refined the login artwork, brand copy, and empty-state onboarding across the app",
        "Updated the Logbook route graphic to reflect real travel records and unified card chips",
        "Reduced font downloads and initial bundle size for quicker loading on mobile roaming"
      ]
    }
  }
}
