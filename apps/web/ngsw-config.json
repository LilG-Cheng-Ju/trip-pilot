{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon.svg",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "!/runtime-config.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "runtime-config",
      "urls": ["/runtime-config.js"],
      "cacheConfig": {
        "maxSize": 1,
        "maxAge": "30d",
        "timeout": "2s",
        "strategy": "freshness"
      }
    },
    {
      "name": "public-readonly",
      "urls": ["**/api/v1/public/trips/**", "**/api/v1/airports/**"],
      "cacheConfig": {
        "maxSize": 25,
        "maxAge": "7d",
        "timeout": "3s",
        "strategy": "freshness"
      }
    }
  ]
}
