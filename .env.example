# Application environment: DEV | PROD
APP_ENV=DEV

# Local development bypass identity (strictly disabled when APP_ENV != DEV)
DEV_USER_ID=dev-local-user

# Database connection (SQLite locally; PostgreSQL / Supabase in production)
DATABASE_URL=sqlite+aiosqlite:///./tripilot.db
# Optional PostgreSQL schema for sharing an existing database instance
DB_SCHEMA=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:4200

# Routing provider (OSRM public endpoint by default)
OSRM_BASE_URL=https://router.project-osrm.org

# Optional Google Places API (New) key; falls back to free OpenStreetMap Photon if empty
GOOGLE_PLACES_API_KEY=

# Optional Firebase service account path (defaults to apps/api/config/firebase-service-account.json)
FIREBASE_CREDENTIALS_PATH=

# Admin / developer emails exempt from rate limits (comma-separated)
ADMIN_EMAILS=billlcj104@gmail.com
# Optional comma-separated invite allowlist for Firebase sign-in (leave empty to allow all)
ALLOWED_EMAILS=
# Rate limiting (defaults to disabled in DEV, enabled in PROD)
RATE_LIMIT_ENABLED=
RATE_LIMIT_PLACES_PER_MIN=30
RATE_LIMIT_PUBLIC_PER_MIN=60
